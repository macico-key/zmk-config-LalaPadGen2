#include <input/processors.dtsi>
#include <dt-bindings/zmk/zip_dynamic_scale.h>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

#define DEFAULT_LAYER   0
#define SECONDARY_LAYER 1
#define TERTIARY_LAYER  2
#define SYSTEM_LAYER    3

&mt { quick-tap-ms = <200>; };

&lt { quick-tap-ms = <200>; };

/ {
    behaviors {
        zip_dyn_scale: zip_dyn_scale {
            compatible = "zmk,behavior-zip-dynamic-scale";
            #binding-cells = <2>;
        };

        zip_dyn_scale_set: zip_dyn_scale_set {
            compatible = "zmk,behavior-zip-dynamic-scale-set";
            #binding-cells = <2>;
        };

        mt2: mod_tap2 {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            flavor = "tap-preferred";
            tapping-term-ms = <200>;
            quick-tap-ms = <200>;
            require-prior-idle-ms = <125>;
            bindings = <&kp>, <&kp>;
        };

        tap_dance_layer_1and2: tap_dance_layer_1and2 {
            compatible = "zmk,behavior-tap-dance";
            label = "td_mo12";
            #binding-cells = <0>;
            bindings = <&mo 1>, <&mo 0>;
        };
    };

    combos {
        compatible = "zmk,combos";

        COMBO_ESC {
            bindings = <&kp ESCAPE>;
            key-positions = <0 1>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        DEFAULT_LAYER {
            display-name = "Default";
            bindings = <
&kp Q        &kp W            &kp E                &kp R                   &kp T                                                &kp Y        &kp U                    &kp I        &kp O          &kp P
&kp A        &kp S            &kp D                &kp F                   &kp G                                                &kp H        &kp J                    &kp K        &kp L          &kp SEMI
&kp Z        &kp X            &kp C                &kp V                   &kp B                                                &kp N        &kp M                    &kp COMMA    &kp DOT        &kp FSLH
&kp LSHFT    &kp LEFT_WIN     &kp LEFT_ALT         &mt LEFT_CONTROL LANG2  &lt 1 SPACE         &kp TAB           &kp BACKSPACE  &lt 1 ENTER  &mt RIGHT_CONTROL LANG1  &mo 4        &kp RIGHT_WIN  &mt RIGHT_SHIFT MINUS
             &kp LC(W)        &kp LG(RIGHT_ARROW)  &kp LG(DOWN_ARROW)      &kp LG(LEFT_ARROW)  &kp LG(UP_ARROW)  &kp UP         &kp LEFT     &kp DOWN                 &kp RIGHT    &kp LS(LG(S))
&mkp LCLK    &mkp RCLK        &mkp MCLK                                                                                                                               &mkp LCLK    &mkp RCLK      &mkp MCLK
&kp LC(TAB)  &kp LC(LS(TAB))  &kp LG(TAB)          &kp LC(W)               &kp LEFT_CONTROL                                     &kp LC(TAB)  &kp LC(LS(TAB))          &kp LG(TAB)  &kp LC(W)      &kp LEFT_CONTROL
            >;
        };

        NUMBER {
            display-name = "Layer1";
            bindings = <
&kp N1           &kp N2       &kp N3    &kp N4      &kp N5                          &kp N6         &kp N7         &kp N8            &kp N9                &kp N0
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                     &kp CARET      &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &trans       &trans    &trans      &trans                          &kp GRAVE      &kp SQT        &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH
&trans           &trans       &trans    &trans      &kp LA(SPACE)  &trans  &kp DEL  &kp LC(ENTER)  &trans         &trans            &trans                &kp EQUAL
                 &trans       &trans    &trans      &trans         &trans  &trans   &trans         &trans         &trans            &trans
&trans           &trans       &trans                                                                              &trans            &trans                &trans
&trans           &trans       &trans    &trans      &trans                          &trans         &trans         &trans            &trans                &trans
            >;
        };

        MAC {
            display-name = "Layer2";
            bindings = <
&kp Q                    &kp W                   &kp E             &kp R           &kp T                                     &kp Y                    &kp U                   &kp I             &kp O              &kp P
&kp A                    &kp S                   &kp D             &kp F           &kp G                                     &kp H                    &kp J                   &kp K             &kp L              &kp SEMI
&kp Z                    &kp X                   &kp C             &kp V           &kp B                                     &kp N                    &kp M                   &kp COMMA         &kp DOT            &kp FSLH
&kp LSHFT                &kp LEFT_CONTROL        &kp LEFT_ALT      &mt LCMD LANG2  &lt 3 SPACE  &kp TAB       &kp BACKSPACE  &lt 3 ENTER              &mt RCMD LANG1          &mo 4             &kp RIGHT_CONTROL  &mt RIGHT_SHIFT MINUS
                         &kp LG(W)               &kp END           &kp LG(END)     &kp HOME     &kp LG(HOME)  &kp UP         &kp LEFT                 &kp DOWN                &kp RIGHT         &kp LS(LG(N5))
&mkp LCLK                &mkp RCLK               &mkp MCLK                                                                                                                    &mkp LCLK         &mkp RCLK          &mkp MCLK
&kp LG(LA(RIGHT_ARROW))  &kp LA(LG(LEFT_ARROW))  &kp LC(UP_ARROW)  &kp LG(W)       &kp LCMD                                  &kp LG(LA(RIGHT_ARROW))  &kp LA(LG(LEFT_ARROW))  &kp LC(UP_ARROW)  &kp LG(W)          &kp LCMD
            >;
        };

        MAC_NUMBER {
            display-name = "Layer3";
            bindings = <
&kp N1           &kp N2       &kp N3    &kp N4      &kp N5                          &kp N6         &kp N7         &kp N8            &kp N9                &kp N0
&kp EXCLAMATION  &kp AT_SIGN  &kp HASH  &kp DOLLAR  &kp PERCENT                     &kp CARET      &kp AMPERSAND  &kp ASTERISK      &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS
&trans           &trans       &trans    &trans      &trans                          &kp GRAVE      &kp SQT        &kp LEFT_BRACKET  &kp RIGHT_BRACKET     &kp BACKSLASH
&trans           &trans       &trans    &trans      &kp LG(SPACE)  &trans  &kp DEL  &kp LG(ENTER)  &trans         &trans            &trans                &kp EQUAL
                 &trans       &trans    &trans      &trans         &trans  &trans   &trans         &trans         &trans            &trans
&trans           &trans       &trans                                                                              &trans            &trans                &trans
&trans           &trans       &trans    &trans      &trans                          &trans         &trans         &trans            &trans                &trans
            >;
        };

        FUNCTION {
            display-name = "Layer4";
            bindings = <
&kp F1   &kp F2   &kp F3  &kp F4  &kp F5                  &kp F6                         &kp F7                         &kp F8                         &kp F9                         &kp F10
&kp F11  &kp F12  &trans  &trans  &trans                  &zip_dyn_scale ZDS_XY ZDS_INC  &zip_dyn_scale ZDS_XY ZDS_DEC  &zip_dyn_scale ZDS_SC ZDS_INC  &zip_dyn_scale ZDS_SC ZDS_DEC  &zip_dyn_scale ZDS_ALL ZDS_RST
&trans   &trans   &trans  &trans  &tog 2                  &bt BT_SEL 0                   &bt BT_SEL 1                   &bt BT_SEL 2                   &bt BT_CLR                     &bt BT_CLR_ALL
&trans   &trans   &trans  &trans  &trans  &trans  &trans  &trans                         &trans                         &trans                         &trans                         &trans
         &trans   &trans  &trans  &trans  &trans  &trans  &trans                         &trans                         &trans                         &trans
&trans   &trans   &trans                                                                                                &trans                         &trans                         &trans
&trans   &trans   &trans  &trans  &trans                  &trans                         &trans                         &trans                         &trans                         &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
